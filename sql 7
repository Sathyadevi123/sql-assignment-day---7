select * from emps;
select * from deps;

# innner join
select emps.empid,emps.epname,deps.depname
from emps
inner join deps
on emps.depid = deps.depid;

#left join
select emps.empid,emps.epname,deps.depname
from emps
left join deps
on emps.depid = deps.depid;

#right join
select emps.empid,emps.epname,deps.depname
from emps
right join deps
on emps.depid = deps.depid;

#full outer join
select emps.empid,emps.epname,deps.depname
from emps
inner join deps
on emps.depid = deps.depid
union
select emps.empid,emps.epname,deps.depname
from emps
inner join deps
on emps.depid = deps.depid;

#cross join
select emps.empid,emps.epname,deps.depname
from emps
cross join deps;

